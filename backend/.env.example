# ==============================================================================
# BIZFLOW 3D BACKEND ENVIRONMENT CONFIGURATION TEMPLATE
# Sao chép tệp này thành `.env` tại thư mục backend/ và điền các giá trị thực tế.
# ==============================================================================

# ── Cấu hình Máy chủ (Server) ──────────────────────────────────────────────────
PORT=3001
NODE_ENV=development

# ── Cơ sở dữ liệu (PostgreSQL - Neon Serverless hoặc Local) ───────────────────
# Ví dụ kết nối Neon Cloud:
DATABASE_URL=postgresql://neondb_owner:your_password@ep-example-123456.us-east-2.aws.neon.tech/neondb?sslmode=require
# Ví dụ kết nối PostgreSQL cục bộ:
# DATABASE_URL=postgresql://postgres:123456@localhost:5432/BizFlow3d

# ── Hạ tầng Bộ đệm & Quản lý Phiên (Redis - Docker Container) ─────────────────
# Khởi chạy qua lệnh: docker compose up -d (dịch vụ bizflow-redis)
REDIS_URL=redis://localhost:6379

# ── Xác thực & Bảo mật Token (JSON Web Token) ──────────────────────────────────
# QUAN TRỌNG: Hãy tạo chuỗi khóa bí mật ngẫu nhiên bảo mật cao trên môi trường Production
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_REFRESH_SECRET=your-refresh-secret-key-change-in-production
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ── Cấu hình CORS & Frontend URL ──────────────────────────────────────────────
CORS_ORIGIN=http://localhost:3000
FRONTEND_URL=http://localhost:3000

# ── Cổng thanh toán trực tuyến quốc tế Stripe (PCI-DSS Level 1) ────────────────
# Lấy từ Stripe Dashboard: https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key_here
# Lấy từ Stripe Webhook CLI hoặc Dashboard Webhooks (dùng để xác thực chữ ký HMAC-SHA256)
STRIPE_WEBHOOK_SECRET=whsec_your_stripe_webhook_signing_secret_here
STRIPE_CURRENCY=vnd

# ── Quản lý Kho & Ngưỡng Cảnh báo Tồn kho Tối thiểu ────────────────────────────
# Khi tồn kho một mặt hàng <= ngưỡng này, hệ thống tự động bắn WebSocket cảnh báo đỏ lên màn hình 3D WMS
LOW_STOCK_THRESHOLD=10

# ── Lưu trữ Tệp & Ảnh Sản phẩm (Cloudinary) ───────────────────────────────────
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
CLOUDINARY_FOLDER=bizflow/products

# ── Nhật ký Hệ thống (Logging) ─────────────────────────────────────────────────
# Mức độ log: debug | info | warn | error
LOG_LEVEL=debug
